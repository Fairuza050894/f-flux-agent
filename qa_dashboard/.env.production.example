# Hermes QA Dashboard production configuration
#
# Copy this file to:
#   qa_dashboard/.env.production
#
# Do not commit the real production file.

APP_ENV=production

# Persistence
QA_DASHBOARD_DATABASE_URL=sqlite:///skills/qa_automation/artifacts/runtime/qa_dashboard.db
QA_DASHBOARD_WORKSPACE_ID=production
QA_DASHBOARD_SYNC_ENABLED=true
QA_DASHBOARD_STRICT_CONFIG=true

# Public application origin. Use HTTPS in production.
QA_DASHBOARD_FRONTEND_ORIGINS=https://qa.example.com

# Default system under test.
QA_DEFAULT_URL=https://target.example.com

# Authentication
QA_DASHBOARD_AUTH_REQUIRED=true
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin@example.com

# Prefer a password hash. Leave the plaintext password empty
# when a hash is configured.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Replace with a stable random value of at least 32 characters.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-stable-random-secret
HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200
QA_DASHBOARD_BASIC_AUTH_ROLE=admin

# Authorization
QA_DASHBOARD_ADMIN_USERS=admin@example.com
QA_DASHBOARD_QA_LEAD_USERS=
QA_DASHBOARD_TESTER_USERS=
QA_DASHBOARD_VIEWER_USERS=

# API hardening
QA_DASHBOARD_ALLOW_PRIVATE_TARGETS=false
QA_DASHBOARD_MAX_REQUEST_BYTES=15728640
QA_DASHBOARD_WRITE_RATE_LIMIT_PER_MINUTE=120

# Reliability and observability
QA_DASHBOARD_AUDIT_MAX_EVENTS=1000
QA_DASHBOARD_STALE_EXECUTION_SECONDS=1800
QA_DASHBOARD_READINESS_REQUIRE_TELEGRAM=false
QA_DASHBOARD_OPERATIONS_POLL_SECONDS=15

# Single-origin frontend serving
QA_DASHBOARD_SERVE_FRONTEND=true
QA_DASHBOARD_FRONTEND_DIST=qa_dashboard/frontend_v3/dist

# Runtime binding. Keep 127.0.0.1 when TLS is terminated
# by a reverse proxy on the same host.
QA_DASHBOARD_HOST=127.0.0.1
QA_DASHBOARD_PORT=8765
QA_DASHBOARD_FORWARDED_ALLOW_IPS=127.0.0.1

# Optional Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TESTING_THREAD_ID=
TELEGRAM_DOCUMENTATION_THREAD_ID=
