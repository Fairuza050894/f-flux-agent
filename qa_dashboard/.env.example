# Hermes QA Dashboard — example configuration
# Copy values into skills/qa_automation/.env for local use.
# Never commit real tokens, credentials, or passwords.

APP_ENV=development

QA_DASHBOARD_DATABASE_URL=sqlite:///skills/qa_automation/artifacts/runtime/qa_dashboard.db
QA_DASHBOARD_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QA_DASHBOARD_WORKSPACE_ID=default
QA_DASHBOARD_SYNC_ENABLED=true
QA_DASHBOARD_STRICT_CONFIG=false

QA_DEFAULT_URL=https://example.test

# P8-B authentication. Keep false only for trusted loopback development.
QA_DASHBOARD_AUTH_REQUIRED=false

# Reuses the built-in Hermes BasicAuthProvider.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
HERMES_DASHBOARD_BASIC_AUTH_TTL_SECONDS=43200

# Role assigned to the configured BasicAuthProvider identity.
# Supported: admin, qa_lead, tester, viewer.
QA_DASHBOARD_BASIC_AUTH_ROLE=admin

# Optional identity-to-role mappings for OAuth/OIDC providers.
QA_DASHBOARD_ADMIN_USERS=admin
QA_DASHBOARD_QA_LEAD_USERS=
QA_DASHBOARD_TESTER_USERS=
QA_DASHBOARD_VIEWER_USERS=

# API hardening.
QA_DASHBOARD_ALLOW_PRIVATE_TARGETS=false
QA_DASHBOARD_MAX_REQUEST_BYTES=15728640
QA_DASHBOARD_WRITE_RATE_LIMIT_PER_MINUTE=120

# P8-C reliability, audit, and observability.
QA_DASHBOARD_AUDIT_MAX_EVENTS=5000
QA_DASHBOARD_STALE_EXECUTION_SECONDS=1800
QA_DASHBOARD_READINESS_REQUIRE_TELEGRAM=false
QA_DASHBOARD_OPERATIONS_POLL_SECONDS=15

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TESTING_THREAD_ID=
TELEGRAM_DOCUMENTATION_THREAD_ID=
# P8-D2 production packaging
#
# For production, copy qa_dashboard/.env.production.example
# to qa_dashboard/.env.production and use:
#   ./venv/bin/python3 scripts/validate_qa_dashboard_production.py
#   ./venv/bin/python3 scripts/qa_dashboard_production.py
QA_DASHBOARD_SERVE_FRONTEND=false
QA_DASHBOARD_FRONTEND_DIST=qa_dashboard/frontend_v3/dist
QA_DASHBOARD_HOST=127.0.0.1
QA_DASHBOARD_PORT=8765
QA_DASHBOARD_FORWARDED_ALLOW_IPS=127.0.0.1
